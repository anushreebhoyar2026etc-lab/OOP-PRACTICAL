#include <iostream>                         // Input-output library
using namespace std;

// Base class for employee basic information
class Employee
{
protected:
    string name;                            // Store employee name
    int id;                                 // Store employee ID

public:
    void getEmployeeData()                  // Function to get employee details
    {
        cout << "Enter Employee ID: ";
        cin >> id;                          // Input employee ID

        cout << "Enter Employee Name: ";
        cin >> name;                        // Input employee name
    }
};

// Base class for department information
class Department
{
protected:
    string department;                      // Store department name
    string designation;                     // Store designation
    string joiningDate;                     // Store joining date

public:
    void getDepartmentData()                // Function to get department details
    {
        cout << "Enter Department: ";
        cin >> department;                  // Input department

        cout << "Enter Designation: ";
        cin >> designation;                 // Input designation

        cout << "Enter Joining Date: ";
        cin >> joiningDate;                 // Input joining date
    }
};

// Derived class using multiple inheritance
class EmployeeProfile : public Employee, public Department
{
public:
    void display()                          // Function to display profile
    {
        cout << "\n--- Employee Profile ---" << endl;
        cout << "Employee ID: " << id << endl;
        cout << "Employee Name: " << name << endl;
        cout << "Department: " << department << endl;
        cout << "Designation: " << designation << endl;
        cout << "Joining Date: " << joiningDate << endl;
    }
};

int main()
{
    EmployeeProfile e;                      // Create object

    e.getEmployeeData();                    // Get employee information
    e.getDepartmentData();                  // Get department information

    e.display();                            // Display employee profile

    return 0;                               // End program
}
