
#include <iostream>
using namespace std;

// Base class
class FoodItem {
public:
    // Virtual function
    virtual void calculateBill() {
        cout << "Calculating food bill..." << endl;
    }
};

// Derived class Pizza
class Pizza : public FoodItem {
public:
    void calculateBill() override {
        int price = 250;
        cout << "Pizza Bill = Rs. " << price << endl;
    }
};

// Derived class Burger
class Burger : public FoodItem {
public:
    void calculateBill() override {
        int price = 120;
        cout << "Burger Bill = Rs. " << price << endl;
    }
};

int main() {
    Pizza p;
    Burger b;

    // Base class pointer
    FoodItem *item;

    // Calls Pizza's calculateBill()
    item = &p;
    item->calculateBill();

    // Calls Burger's calculateBill()
    item = &b;
    item->calculateBill();

    return 0;
}
